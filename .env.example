# Groq is used for receipt extraction and product identity comparison only.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

# Google OAuth web application credentials (Gmail API sending)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4100/api/email/oauth/callback
FRONTEND_URL=http://localhost:5173

# Optional initial alert destination; manage multiple recipients in Price monitor
ALERT_TO=where_you_want_to_receive_alerts@gmail.com

# Price checks run at most once per calendar day (minimum 24 hours)
PRICE_CHECK_INTERVAL_HOURS=24

# Alternative-offer refresh interval (hours; minimum 6)
ALTERNATIVE_DISCOVERY_INTERVAL_HOURS=24

# Minimum time between scheduled original-product discovery attempts (hours)
PUBLIC_PRODUCT_DISCOVERY_INTERVAL_HOURS=24
