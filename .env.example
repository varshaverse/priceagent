# Groq is used for receipt extraction and product identity comparison only.
AI_PROVIDER=groq
GROQ_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Google OAuth web application credentials (Gmail API sending)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4100/api/email/oauth/callback
FRONTEND_URL=http://localhost:5173

# Optional initial alert destination; manage multiple recipients in Price monitor
ALERT_TO=where_you_want_to_receive_alerts@gmail.com

# How often to check watched products (minutes; minimum 15)
MONITOR_INTERVAL_MINUTES=60

# Automatic retailer product discovery and alternative-offer refresh interval (hours; minimum 6)
ALTERNATIVE_DISCOVERY_INTERVAL_HOURS=24
